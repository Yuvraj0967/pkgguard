{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": { "drop_excess_requests": false },
  "providers": {
    "gemini": {
      "keys": [
        { "name": "gemini-key", "value": "env.GEMINI_API_KEY", "models": ["*"], "weight": 1.0 }
      ]
    }
  },
  "config_store": { "enabled": false },
  "logs_store": { "enabled": false }
}
